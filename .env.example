# ─── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ML_SERVICE_URL=http://localhost:5000/api/ml
VITE_GOOGLE_CLIENT_ID=
VITE_MAP_DEFAULT_LAT=19.0760
VITE_MAP_DEFAULT_LNG=72.8777
# Set to 'true' only for local development without a running backend
VITE_MOCK_MODE=false

# ─── Backend Security ──────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# ─── Database ──────────────────────────────────────────────────────────────────
# Database password used in docker-compose.yml for PostgreSQL container
DB_PASSWORD=CHANGE_ME_strong_db_password
# PostgreSQL (preferred for production)
DATABASE_URL=postgresql://kaiser_user:CHANGE_DB_PASSWORD@localhost:5432/kaiser_civic
# SQLite (for local dev only — no PostgreSQL needed)
# DATABASE_URL=sqlite:///./kaiser_civic.db

# ─── AWS S3 File Storage ───────────────────────────────────────────────────────
# Leave blank to use local filesystem (backend/uploads/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=

# ─── AI Assistant API Keys (all optional — use at least one for live AI) ───────
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── Mumbai Civic News API (NewsAPI.org) ──────────────────────────────────────
# Obtain API key from https://newsapi.org/
NEWS_API_KEY=

# ─── AI Foundation Models (OpenAI CLIP & ViT Authenticity) ─────────────────────
# OpenAI CLIP ViT-B/32 runs via Hugging Face Transformers & PyTorch
# AI Image Detector local weights path (default: ./models/ai_detector)
AI_DETECTOR_MODEL_DIR=./models/ai_detector

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# CORS origins for production (comma-separated). Leave blank for localhost-only dev mode.
ALLOWED_ORIGINS=
